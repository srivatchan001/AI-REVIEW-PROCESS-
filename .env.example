# ─────────────────────────────────────────────────────────────────────────────
# Environment Variable Configuration Template
# Copy this file to .env and adjust values as needed.
# All sensitive secrets are kept out of frontend code.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite default for zero-setup execution. Can also be set to PostgreSQL URL.
DATABASE_URL=sqlite:///./recruitment.db

# ─── Security / JWT ──────────────────────────────────────────────────────────
SECRET_KEY=change-in-production-use-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── AI Configuration ────────────────────────────────────────────────────────
# Supported providers: "gemini" | "openai"
AI_MODEL=gemini
# Keep API keys empty to use the built-in, clearly labelled Demo Mode
GEMINI_API_KEY=
OPENAI_API_KEY=
# Force demo evaluation output even if API key is present:
AI_DEMO_MODE=true

# ─── Email / SMTP Integration ────────────────────────────────────────────────
# Standard SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@recruitment.com
# When DEMO_EMAIL_MODE=true, emails are logged to the database without connecting to SMTP
DEMO_EMAIL_MODE=true

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
